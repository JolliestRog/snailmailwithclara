{
  "name": "snailmailwithclara",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "dev:ui": "vite",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply snailmailwithclara --local",
    "db:migrate:remote": "wrangler d1 migrations apply snailmailwithclara --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build",
    "bootstrap": "node scripts/bootstrap.mjs"
  },
  "dependencies": {
    "@noble/curves": "^2.0.1",
    "@simplewebauthn/browser": "^13.2.2",
    "@simplewebauthn/server": "^13.2.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260922.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "jsdom": "^27.0.0",
    "prettier": "^3.9.8",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^5.0.1",
    "wrangler": "^4.136.3"
  }
}
