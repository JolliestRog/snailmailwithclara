{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "snailmailwithclara",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "snailmailwithclara",
      "database_id": "6ef17caf-9537-4a29-a015-85e6914d84ca",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "snailmailwithclara-media",
    },
  ],
  "routes": [
    {
      "pattern": "snailmailwithclara.facey.page",
      "custom_domain": true,
    },
  ],
  "vars": {
    "RP_NAME": "Snail Mail with Clara",
    "RP_ID": "snailmailwithclara.facey.page",
    "ORIGIN": "https://snailmailwithclara.facey.page",
    "NOTIFY_FROM": "notifications@snailmailwithclara.facey.page",
    "RESEND_FROM": "Snail Mail with Clara <noreply@riotbuddies.facey.page>",
    "REPOSITORY_URL": "https://github.com/JolliestRog/snailmailwithclara",
    "BUILD_SHA": "development",
  },
  "triggers": {
    "crons": ["17 3 * * *"],
  },
}
